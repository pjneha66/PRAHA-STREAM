{
  "name": "praha-stream",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm test && npm run build",
    "server:cloudstream": "node scripts/cloudstream-server.mjs",
    "dev:full": "node scripts/cloudstream-server.mjs --dev",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:android": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "dashjs": "^5.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.65.0",
    "mpegts.js": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  },
  "description": "A local-first Android & web streaming interface for Stremio addons, Nuvio plugins, and CloudStream extensions."
}
