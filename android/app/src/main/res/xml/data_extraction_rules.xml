<?xml version="1.0" encoding="utf-8"?>
<!--
  The WebView localStorage holds the TMDB key, debrid API key and Trakt/Simkl
  tokens in plaintext (data/defaults.ts). Exclude all app data from both cloud
  backup and device-to-device transfer so those secrets never leave the device
  through the platform backup pipeline (audit H-08).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
